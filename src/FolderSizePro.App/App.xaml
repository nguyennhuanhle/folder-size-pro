<Application x:Class="FolderSizePro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:FolderSizePro.App"
             ShutdownMode="OnMainWindowClose"
             ThemeMode="System">
    <Application.Resources>
        <app:InverseBoolToVisibility x:Key="InvBoolVis" />
        <app:NullToVisibility x:Key="NullVis" />
        <app:BoolNot x:Key="BoolNot" />
        <app:BannerBackground x:Key="BannerBg" />
        <app:BannerBorder x:Key="BannerBd" />
        <app:LevelToBrush x:Key="LevelBrush" />
        <app:LevelToWeight x:Key="LevelWeight" />
        <app:DirectionToBrush x:Key="DirBrush" />
        <app:IndentToThickness x:Key="IndentThickness" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="StretchItem" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
    </Application.Resources>
</Application>
